# Copy this file to .env for LOCAL use (keep .env out of version control).
# On Render, set these in the service's Environment tab instead.
# Real environment variables always win over the .env file.
#
# The database is a local SQLite file (library.db), so there are no DB
# credentials to configure.

# Flask session signing key. Required in production - app.py falls
# back to an insecure development-only value if this is unset.
FLASK_SECRET_KEY=change-this-to-a-long-random-value

# Forgot Password OTP emails are sent through the Resend HTTPS API.
# Create a key at https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key

# Sender address. Use an address on a domain you verified in Resend,
# e.g.  Library <noreply@yourdomain.com>
# For quick testing only: onboarding@resend.dev (Resend only delivers
# that to the email address of your own Resend account).
RESEND_FROM_EMAIL=Library <noreply@yourdomain.com>

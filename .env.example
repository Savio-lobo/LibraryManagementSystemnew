# Copy this file to .env (and keep .env OUT of version control / GitHub).
# On a hosting service, set these same names as environment variables
# instead - real environment variables always win over this file.

# ---------------------------------------------------------------
# DATABASE - the ONE central cloud PostgreSQL database.
# Every Admin / Librarian / User of the app reads and writes this same
# database. Paste the connection string from your provider (Neon:
# Dashboard -> Connect -> choose the "Pooled connection" string).
# It looks like:
#   postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# ---------------------------------------------------------------
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Optional tuning (defaults shown). Keep DB_POOL_MAX small on free plans.
# DB_POOL_MAX=5

# Flask session signing key. REQUIRED in production, and it must be the
# SAME value on every server instance, otherwise users get logged out.
# Generate one:  python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-this-to-a-long-random-value

# The app stores/compares dates using the server's clock. Servers are
# usually in UTC, which would shift "due tomorrow" / "overdue" by hours.
# Set the library's local timezone on the server, e.g.:
# TZ=Asia/Kolkata

# ONE server-side SENDER account for the whole application (Forgot
# Password OTP emails). NOT any user's credentials. For Gmail,
# MAIL_PASSWORD is a Google "App Password".
MAIL_USERNAME=your_sender_gmail@gmail.com
MAIL_PASSWORD=your_gmail_app_password

# OPTIONAL - only if you use a different SMTP provider instead of Gmail
# MAIL_SERVER=smtp.example.com
# MAIL_PORT=587
# MAIL_USE_TLS=true
# MAIL_USE_SSL=false
# MAIL_SENDER=library@example.com
